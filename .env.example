# Optional: Google Analytics 4 — Admin → Data streams → Web → Measurement ID (G-XXXXXXXX)
# No GitHub Actions deployment workflow currently exists in this repository.
# If a future, separately reviewed workflow is added, you may also set repo secret
# NEXT_PUBLIC_GA_MEASUREMENT_ID for authorized CI builds.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Public Turnstile site key embedded into the static browser build.
# Leave empty to disable online submission and keep the mailto fallback only.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Contact Function runtime configuration.
# Production secret values belong in Cloudflare Pages secret storage, never this file,
# GitHub, CI logs, browser JavaScript, issue comments, or pull-request text.
# TURNSTILE_SECRET_KEY=
# RESEND_API_KEY=

# Fixed server-side addresses. The browser cannot choose recipients or sender values.
# CONTACT_FROM_EMAIL=EuroDigital <website@eurodigital.ca>
# CONTACT_TO_EMAIL=contact@eurodigital.ca

# Comma-separated exact origins allowed to call /api/contact.
# Add an explicitly approved preview origin only while testing that preview.
# CONTACT_ALLOWED_ORIGINS=https://eurodigital.ca,https://www.eurodigital.ca

# Optional comma-separated hostnames expected from Turnstile Siteverify.
# When omitted, hostnames are derived from CONTACT_ALLOWED_ORIGINS.
# TURNSTILE_ALLOWED_HOSTNAMES=eurodigital.ca,www.eurodigital.ca

# Optional: scripts/cf-api.js (manual Cloudflare helpers — not needed for local site build)
# Some commands are PRODUCTION-CHANGING (see README). Do not run those without explicit authorization.
# CLOUDFLARE_API_TOKEN=
# CLOUDFLARE_API_EMAIL=
# CLOUDFLARE_GLOBAL_API_KEY=
