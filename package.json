{
  "name": "portfolio",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "22.17.1",
    "npm": "10.9.2"
  },
  "packageManager": "npm@10.9.2",
  "scripts": {
    "dev": "next dev -p 3011 -H 127.0.0.1",
    "dev:clean": "node -e \"try{require('fs').rmSync('.next',{recursive:true,force:true})}catch(e){}\" && next dev -p 3011 -H 127.0.0.1",
    "build": "next build",
    "test": "node --test test/*.test.mjs",
    "contact:preflight": "node scripts/contact-preflight.mjs",
    "contact:smoke": "node scripts/contact-smoke.mjs",
    "sync:brand": "node scripts/sync-brand-assets.mjs",
    "capture:screens": "node scripts/capture-screenshots.mjs",
    "assets:refresh": "npm run sync:brand && npm run capture:screens",
    "lighthouse": "npm run build && node scripts/lighthouse.mjs",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "pages:preview": "npm run build && wrangler pages dev out",
    "pages:preview:build": "node scripts/pages-build.mjs --target preview",
    "pages:preview:deploy": "node scripts/pages-deploy.mjs --target preview",
    "pages:production:build": "node scripts/pages-build.mjs --target production",
    "pages:production:preflight": "node scripts/pages-production-preflight.mjs",
    "pages:production:deploy": "node scripts/pages-deploy.mjs --target production"
  },
  "dependencies": {
    "framer-motion": "^12.38.0",
    "next": "^15.5.21",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@types/node": "^22.15.21",
    "@types/react": "^19.1.6",
    "@types/react-dom": "^19.1.5",
    "eslint": "^9.26.0",
    "eslint-config-next": "^15.5.21",
    "jsonc-parser": "^3.3.1",
    "lighthouse": "^12.8.2",
    "playwright": "^1.59.1",
    "postcss": "^8.5.18",
    "sharp": "^0.35.3",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.8.3",
    "wrangler": "^4.90.1"
  },
  "overrides": {
    "postcss": "$postcss",
    "sharp": "$sharp"
  }
}
