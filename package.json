{
  "name": "portfolio",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "20.x"
  },
  "scripts": {
    "dev": "next dev -p 3011 -H 127.0.0.1",
    "dev:clean": "node -e \"try{require('fs').rmSync('.next',{recursive:true,force:true})}catch(e){}\" && next dev -p 3011 -H 127.0.0.1",
    "build": "next build",
    "sync:brand": "node scripts/sync-brand-assets.mjs",
    "capture:screens": "node scripts/capture-screenshots.mjs",
    "assets:refresh": "npm run sync:brand && npm run capture:screens",
    "lighthouse": "npm run build && node scripts/lighthouse.mjs",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "pages:deploy": "npm run build && wrangler pages deploy out --project-name=eurodigital-ca --branch=main --commit-dirty=true",
    "pages:preview": "npm run build && wrangler pages dev out"
  },
  "dependencies": {
    "framer-motion": "^12.38.0",
    "next": "^15.5.15",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@types/node": "^22.15.21",
    "@types/react": "^19.1.6",
    "@types/react-dom": "^19.1.5",
    "eslint": "^9.26.0",
    "eslint-config-next": "^15.5.0",
    "playwright": "^1.59.1",
    "postcss": "^8.5.3",
    "sharp": "^0.34.5",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.8.3",
    "wrangler": "^4.90.1",
    "lighthouse": "^12.8.2"
  }
}
